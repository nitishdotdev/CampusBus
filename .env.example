# Local PostgreSQL example. Use a secret-managed connection string for deployment.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/campusbus_dev
# Production PostgreSQL defaults to full TLS verification.
# DATABASE_SSL_MODE=verify
# DATABASE_CA_CERT_FILE=/path/to/private-ca.crt

# Generate two different values with openssl rand -hex 32.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

PORT=4000
# Local defaults include localhost and 127.0.0.1 ports 3000 and 5173.
# Set the exact HTTPS frontend origin in production.
# CORS_ORIGIN=https://transit.example.edu

# Prefer the provisioning CLI. Leave the HTTP bootstrap access disabled by default.
# BOOTSTRAP_SECRET=

# Optional email recovery. Use a verified Resend sender and a send-only key.
# EMAIL_FROM=dispatch@example.edu
# RESEND_API_KEY=

# New trip stop arrivals use this radius when supplied in metres (default 50).
# GEOFENCE_RADIUS_METERS=50

# Vite dev uses its API and WebSocket proxy by default.
# Production builds require an absolute API origin without credentials or a path.
# VITE_API_V1_URL=https://api.transit.example.edu

# Optional tile provider. Include the provider's required attribution.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors

# Development simulation is opt-in on the API and is refused in production.
# SIMULATION_MODE=off
