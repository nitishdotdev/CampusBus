# CampusMove Environment Variables
# Copy this file to .env and fill in the values

# ============================================
# REQUIRED: Database
# ============================================
# MongoDB connection string (MERN stack - primary for production)
# Example: mongodb+srv://user:password@cluster.mongodb.net/campusmove
# Or PostgreSQL: postgres://user:password@host:5432/campusmove
# Leave empty for in-process file-based storage fallback (development only)
DATABASE_URL=postgresql://user:password@localhost:5432/campusmove

# ============================================
# REQUIRED: Authentication
# ============================================
# JWT secret - use a strong random string (min 32 characters)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_change_this_in_production

# ============================================
# OPTIONAL: Deployment URLs
# ============================================
# App base URL (used for self-referential links and OAuth callbacks)
APP_URL=http://localhost:3000

# Frontend API base URL (if separate from backend)
# Leave empty for same-origin deployment
VITE_API_URL=

# Frontend WebSocket URL (if separate from backend)
# Leave empty for same-origin deployment
VITE_SOCKET_URL=

# ============================================
# CORS (applies to the REST API and Socket.IO)
# ============================================
# Comma-separated bare origins (scheme://host[:port], no paths). '*' is rejected.
# Production: https only (localhost allowed for testing). Unset in production = same-origin only.
# Development default when unset: http://localhost:3000, :5173 and 127.0.0.1 equivalents.
CORS_ORIGIN=http://localhost:5173

# ============================================
# PostgreSQL TLS (legacy store; certificate verification is never disabled)
# ============================================
# verify  = validate chain + hostname (default in production)
# disable = plaintext; only for a private/internal network URL or local dev (must be explicit in production)
DATABASE_SSL_MODE=disable
# encrypt-private = TLS without certificate verification; ONLY accepted for private-network hosts
#                   (e.g. Render INTERNAL database URL, whose certificates are self-signed). Rejected for public hosts.
# TLS parameters inside DATABASE_URL (sslmode=...) are ignored/refused: this variable alone controls TLS.
# Private CA for the database server, if the provider does not use a public CA (PEM text with \n escapes, or a file path)
DATABASE_CA_CERT=
DATABASE_CA_CERT_FILE=

# ============================================
# OPTIONAL: Server
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# OPTIONAL: AI features
# ============================================
# Google Gemini API key (for AI-powered features if enabled)
GEMINI_API_KEY=

# ============================================
# New MongoDB API (apps/api)  -- not yet the production backend
# ============================================
MONGODB_URI=mongodb://localhost:27017/campusmove
# >= 32 characters. The API refuses to start without it (no development fallback).
ACCESS_TOKEN_SECRET=
# GPS tracking. SIMULATION_MODE=on is rejected when NODE_ENV=production.
SIMULATION_MODE=off
TELEMETRY_RETENTION_DAYS=90
TELEMETRY_RATE_LIMIT_EVENTS=120

# ============================================
# Test-only (never point at production): enable the integration suites
# ============================================
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017
# PG_TEST_URL=postgres://postgres:postgres@localhost:5432/campusmove_test
# PG_TLS_TEST_URL=postgres://postgres:postgres@localhost:54330/postgres
# PG_TLS_TEST_CA_FILE=/path/to/ca.crt
