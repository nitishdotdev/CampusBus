# ── apps/api (backend) ────────────────────────────────────────────────────────

# MongoDB Atlas connection string (required)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusmove?retryWrites=true&w=majority

# Token secrets — generate with: openssl rand -hex 32
# These two values MUST differ from each other
ACCESS_TOKEN_SECRET=replace-with-32-plus-char-random-string
REFRESH_TOKEN_SECRET=replace-with-a-different-32-plus-char-string

# API server port (default: 4000)
PORT=4000

# Comma-separated allowed frontend origins (no trailing slash)
CORS_ORIGIN=http://localhost:5173

# Bootstrap secret — used once to create the first campus via POST /api/v1/campuses
# Leave blank or remove after the first campus record exists
BOOTSTRAP_SECRET=replace-with-a-long-random-secret

# Email delivery (optional — defaults to console logging when not set)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# EMAIL_FROM=noreply@yourcampus.edu

# Simulation mode: 'on' or 'off' (never 'on' in production)
# SIMULATION_MODE=off

# Telemetry retention in days (default: 90)
# TELEMETRY_RETENTION_DAYS=90

# ── apps/web (frontend — Vite env vars, must start with VITE_) ───────────────

# URL of the apps/api backend (no trailing slash)
VITE_API_V1_URL=http://localhost:4000

# Set to 'true' to route auth and data through the new v1 MongoDB API
VITE_USE_V1_API=false

# Legacy / express-ts backend URL (used when VITE_USE_V1_API=false)
VITE_API_URL=http://localhost:3000

# PostgreSQL connection string (optional - falls back to local file storage if not set)
# DATABASE_URL=postgresql://user:password@localhost:5432/campusbus

# Geofence arrival radius in meters (optional - defaults to 50 meters)
GEOFENCE_RADIUS_METERS=50

# Map tile provider (defaults to OpenStreetMap standard tiles; NO API KEY REQUIRED)
# Official documentation: https://operations.osmfoundation.org/policies/tiles/
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
