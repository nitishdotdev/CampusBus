# ── Backend (server.ts — PostgreSQL) ──────────────────────────────────────────

# PostgreSQL connection string (required in production)
# DATABASE_URL=postgresql://user:password@localhost:5432/campusbus

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=replace-with-32-plus-char-random-string

# API server port (default: 3000)
PORT=3000

# Comma-separated allowed frontend origins (no trailing slash)
CORS_ORIGIN=http://localhost:3000

# Bootstrap secret — used once to create the first admin via POST /api/auth/bootstrap-admin
# Leave blank or remove after the first admin exists
# BOOTSTRAP_SECRET=replace-with-a-long-random-secret

# Geofence arrival radius in meters (optional - defaults to 50 meters)
GEOFENCE_RADIUS_METERS=50

# ── Frontend (Vite env vars, must start with VITE_) ───────────────────────────

# URL of the PostgreSQL-backed API (no trailing slash). Leave unset for same-origin.
VITE_API_URL=http://localhost:3000

# Socket.IO URL (defaults to VITE_API_URL / current origin)
VITE_SOCKET_URL=http://localhost:3000

# Keep false in production. The MongoDB v1 API is not the production database.
VITE_USE_V1_API=false

# Map tile provider (defaults to OpenStreetMap standard tiles; NO API KEY REQUIRED)
# Official documentation: https://operations.osmfoundation.org/policies/tiles/
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
